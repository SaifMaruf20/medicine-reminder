# Neon PostgreSQL Connection String (Recommended)
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Alternatively discrete parameters (if not using DATABASE_URL):
# DB_HOST=ep-sample-pooler.us-east-2.aws.neon.tech
# DB_USER=neondb_owner
# DB_PASSWORD=your_password
# DB_NAME=neondb
# DB_PORT=5432
# DB_SSL=true

# JWT Authentication
JWT_SECRET=oshudhsathi-super-secret-jwt-key-2026-university-project
JWT_EXPIRES_IN=30d

# SMS OTP (Optional: if not configured, dev OTP 123456 is used for test numbers)
SMS_API_KEY=your_bulksmsbd_api_key
SMS_SENDER_ID=OshudhSathi

# Firebase Cloud Messaging (Push Notifications - Optional)
FCM_SERVER_KEY=your_firebase_server_key

# App Configuration
PORT=3001
NODE_ENV=development
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Frontend URLs (CORS)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081,https://oshudhsathi.com
